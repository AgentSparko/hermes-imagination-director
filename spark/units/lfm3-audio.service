[Unit]
Description=LFM3-Audio-2B llama-server (ASR, TTS, /v1/realtime) for Hermes
After=network.target

[Service]
EnvironmentFile=-%h/.hermes-imagination-director/env
ExecStart=%h/.hermes-imagination-director/bin/llama-server \
  -m %h/.hermes-imagination-director/models/audio.gguf \
  --mmproj %h/.hermes-imagination-director/models/audio-mmproj.gguf \
  --host 127.0.0.1 --port ${LFM3_AUDIO_PORT} \
  --ctx-size ${LFM3_AUDIO_CTX} --parallel ${LFM3_AUDIO_PARALLEL} \
  -ngl 999 --jinja --flash-attn on --no-warmup \
  --alias LFM3-Audio-2B
Restart=on-failure
RestartSec=3
Nice=5

# Optional extra flags: add them with a drop-in ->  systemctl --user edit lfm3-audio.service
#   [Service]
#   ExecStart=
#   ExecStart=...your full command line plus the extra flags...

[Install]
WantedBy=default.target
